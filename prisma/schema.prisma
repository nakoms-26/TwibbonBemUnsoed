generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Twibbon {
  id          Int         @id @default(autoincrement())
  title       String
  slug        String      @unique
  description String?
  type        OverlayType
  overlayFile String
  thumbnail   String
  config      Json
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  downloadsCount Int         @default(0)

  @@map("twibbon")
}

enum OverlayType {
  IMAGE
  VIDEO
}
